---
import PageShell from "@/components/layout/PageShell.astro";
import PortfolioMark from "@/components/motion/PortfolioMark.astro";
import Cursor from "@/components/primitives/Cursor.astro";
import Frame from "@/components/primitives/Frame.astro";

export const prerender = true;

const year = new Date().getFullYear();

const topLinks = [
  { label: "Email", href: "mailto:SaSorkhi@gmail.com" },
  { label: "Phone", href: "tel:+989395065181" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/Sorkhi", external: true },
  { label: "Instagram", href: "https://www.instagram.com/SaSorkhi", external: true },
];

const bottomLinks = [
  {
    label: "Portfolio",
    href: "https://drive.google.com/file/d/1PpHNjVwOGVOztWJ4ziVrCeRyIz9g1lmb/view?usp=drivesdk",
  },
  {
    label: "Curriculum Vitae",
    href: "https://drive.google.com/file/d/1E9Nyd_ZEQ5h5Kg7KAtv_JDlbbBWFalRz/view?usp=drivesdk",
  },
  {
    label: "Catalogs/Videos",
    href: "https://drive.google.com/drive/folders/1bn-NoPz90lHYAh6k2MmZD0pc65_9ntRP",
  },
];
---

<PageShell
  title="Saeid Sorkhi — Researcher, Visual Communication Expert & Digital Designer"
  description="Explore the portfolio of Saeid Sorkhi, a researcher and digital designer specializing in visual communication, design strategy, and architectural thinking."
  chrome={false}
>
  <div class="hero" data-theme="light" data-hero>
    <Frame />
    <Cursor />

    <nav class="hero__nav hero__nav--top" aria-label="Contact">
      {
        topLinks.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hero__body">
      <div class="hero__row">
        <div class="hero__details">
          <p class="hero__name">SAEID SORKHI</p>
          <p class="hero__role">RESEARCHER &amp; DIGITAL DESIGNER</p>
          <p class="hero__credential">M.A. VISUAL COMMUNICATION</p>
          <p class="hero__credential">B. ARCHITECTURE</p>
        </div>

        <div class="hero__divider" aria-hidden="true"></div>

        <PortfolioMark year={year} />
      </div>
    </div>

    <nav class="hero__nav hero__nav--bottom" aria-label="Sections">
      {
        bottomLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</PageShell>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-12) var(--frame-margin);
    background-color: var(--color-bg);
    color: var(--color-fg);
    overflow: hidden;
    transition:
      background-color var(--duration-flip) var(--ease-out),
      color var(--duration-flip) var(--ease-out);
  }

  /* Click-to-flip state from PortfolioMark's toggle — a bold color swap
     instead of the subtle light/dark theme. Everything goes white except
     the role label and the mark's ring, which go to a darker red so they
     still read as an accent against the red background; the dot goes
     white to stay visible against that darker ring. Specificity beats the
     [data-theme="light"] tokens regardless of stylesheet order. */
  .hero[data-flipped] {
    --color-bg: #d2232a;
    --color-fg: #ffffff;
    --color-accent: #841919;
    --color-accent-glow: rgb(255 255 255 / 25%);
    --color-mark-dot: #ffffff;
  }

  .hero__nav {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }

  .hero__nav a {
    text-decoration: none;
    color: var(--color-fg);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    transition: color var(--duration-base) var(--ease-out);
  }

  .hero__nav--top {
    gap: var(--space-8);
  }

  .hero__nav--top a:hover {
    color: var(--color-accent);
  }

  .hero__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) 0;
  }

  /* A plain (non-flex-1) row so its cross-size is content height, not the
     full .hero__body height — that's what lets .hero__divider's
     align-self: stretch match the flanking text instead of towering. */
  .hero__row {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-24));
  }

  .hero__details {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    text-align: right;
  }

  .hero__name {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__role {
    color: var(--color-accent);
    font-size: var(--text-md);
    font-weight: 300;
    line-height: 1.3;
    transition: color var(--duration-flip) var(--ease-out);
  }

  .hero__credential {
    color: var(--color-fg);
    font-size: var(--text-md);
    font-weight: 200;
    line-height: 1.3;
  }

  /* Sized to the taller of the two flanking blocks (align-self: stretch),
     not an arbitrary fixed length — tightening the line-heights above is
     what keeps this from towering over short content. */
  .hero__divider {
    align-self: stretch;
    width: var(--rule-width);
    background-color: var(--color-fg);
    opacity: 0.6;
    transition: background-color var(--duration-flip) var(--ease-out);
  }

  /* Bottom nav hover: corner-bracket ticks (echoing the page frame) clamp
     onto the link instead of a flat color wipe. */
  .hero__nav--bottom a {
    position: relative;
    padding: var(--space-2) var(--space-3);
  }

  .hero__nav--bottom a::before,
  .hero__nav--bottom a::after {
    content: "";
    position: absolute;
    top: 0;
    width: 0.6rem;
    height: 0.6rem;
    border: var(--rule-width) solid var(--color-accent);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .hero__nav--bottom a::before {
    left: 0;
    border-right: none;
    border-bottom: none;
    transform: translate(4px, 4px) scale(0.6);
  }

  .hero__nav--bottom a::after {
    right: 0;
    bottom: 0;
    top: auto;
    border-left: none;
    border-top: none;
    transform: translate(-4px, -4px) scale(0.6);
  }

  .hero__nav--bottom a:hover {
    color: var(--color-accent);
  }

  .hero__nav--bottom a:hover::before,
  .hero__nav--bottom a:hover::after {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }

  /* Mobile: stack, but lead with the brand mark (like the printed cover)
     rather than the resume-style detail list — order changes visually
     without reordering the DOM/reading order. */
  @media (max-width: 40rem) {
    .hero__row {
      flex-direction: column;
      gap: var(--space-6);
      text-align: center;
    }

    .hero__details {
      order: 2;
      align-items: center;
      text-align: center;
    }

    .hero__divider {
      order: 1;
      width: 4rem;
      height: var(--rule-width);
      align-self: center;
    }

    :global(.mark) {
      order: 0;
    }
  }
</style>
