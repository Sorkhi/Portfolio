---
import "@fontsource-variable/jetbrains-mono";
import jetbrainsMonoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "@/styles/tokens.css";
import "@/styles/base.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title: string;
  description: string;
  /** Set false for full-bleed pages that render their own nav (e.g. the homepage hero). */
  chrome?: boolean;
  /** Path under public/ used for og:image / twitter:image link previews. */
  image?: string;
}

const { title, description, chrome = true, image = "/social-preview.png" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoWoff2} crossorigin />

    <!-- Open Graph — link previews on Telegram, WhatsApp, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    {chrome && <Header />}
    <main>
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
