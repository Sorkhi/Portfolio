---
import ThemeToggle from "@/components/motion/ThemeToggle.astro";
---

<header class="site-header">
  <a class="site-header__mark" href="/">Sorkhi</a>
  <nav class="site-header__nav" aria-label="Primary">
    <a href="/work">Work</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--grid-gutter);
    border-bottom: var(--rule-width) solid var(--color-border);
    background-color: var(--color-bg);
  }

  .site-header__mark {
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-6);
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-header__nav a:hover {
    color: var(--color-fg);
  }
</style>
