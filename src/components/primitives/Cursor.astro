---
// Cursor-following reveal with an irregular "watercolor stain" edge, not a
// plain circular gradient. Two layers do the work: a mask built from a
// cluster of offset blobs (not one circle) gives it an organic base shape,
// then an SVG filter (feTurbulence + feDisplacementMap) bends that shape's
// edges further so it reads as a bleeding ink/watercolor stain rather than
// a soft-focus dot. It reveals the *other* theme's color at the pointer —
// red by default, as if the flipped theme were underneath; white once
// flipped, the reverse — and reverses again when the mark is clicked.
---

<div class="cursor-reveal" data-cursor-reveal aria-hidden="true"></div>

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <filter id="cursor-reveal-edge" x="-80%" y="-80%" width="260%" height="260%">
    <feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="3" seed="11" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="90" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<style>
  .cursor-reveal {
    position: fixed;
    top: 0;
    left: 0;
    width: 30rem;
    height: 30rem;
    margin-top: -15rem;
    margin-left: -15rem;
    background: var(--color-hover-reveal);
    /* A cluster of offset blobs, not one circle — the organic base shape
       the filter below then distorts further. */
    -webkit-mask-image:
      radial-gradient(circle at 40% 38%, black 42%, transparent 78%),
      radial-gradient(circle at 63% 45%, black 38%, transparent 75%),
      radial-gradient(circle at 48% 65%, black 40%, transparent 76%),
      radial-gradient(circle at 60% 68%, black 32%, transparent 70%),
      radial-gradient(circle at 50% 52%, black 20%, transparent 55%);
    mask-image:
      radial-gradient(circle at 40% 38%, black 42%, transparent 78%),
      radial-gradient(circle at 63% 45%, black 38%, transparent 75%),
      radial-gradient(circle at 48% 65%, black 40%, transparent 76%),
      radial-gradient(circle at 60% 68%, black 32%, transparent 70%),
      radial-gradient(circle at 50% 52%, black 20%, transparent 55%);
    filter: url(#cursor-reveal-edge);
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
    will-change: transform, opacity;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      background-color var(--duration-flip) var(--ease-out);
  }

  @media (pointer: coarse) {
    .cursor-reveal {
      display: none;
    }
  }
</style>

<script>
  function onIdle(callback: () => void) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback);
    } else {
      setTimeout(callback, 200);
    }
  }

  onIdle(async () => {
    const reveal = document.querySelector<HTMLElement>("[data-cursor-reveal]");
    if (!reveal || window.matchMedia("(pointer: coarse)").matches) return;

    const { withMotion } = await import("@/lib/motion");

    withMotion(({ gsap, reduced }) => {
      if (reduced) return;

      const moveX = gsap.quickTo(reveal, "x", { duration: 0.45, ease: "power3" });
      const moveY = gsap.quickTo(reveal, "y", { duration: 0.45, ease: "power3" });

      window.addEventListener("pointermove", (event) => {
        reveal.style.opacity = "1";
        moveX(event.clientX);
        moveY(event.clientY);
      });

      window.addEventListener("pointerleave", () => {
        reveal.style.opacity = "0";
      });
    });
  });
</script>
