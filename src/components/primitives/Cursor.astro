---
// Cursor-following reveal with a soft, irregular "watercolor" edge (an SVG
// feTurbulence/feDisplacementMap filter distorting a masked blob) instead of
// a plain circular gradient. It reveals the *other* theme's color at the
// pointer — red in the default state, white once flipped — so it reads as
// the flip-side peeking through, and reverses when the mark is clicked.
---

<div class="cursor-reveal" data-cursor-reveal aria-hidden="true"></div>

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <filter id="cursor-reveal-edge" x="-50%" y="-50%" width="200%" height="200%">
    <feTurbulence type="fractalNoise" baseFrequency="0.015 0.025" numOctaves="2" seed="7" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="34" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<style>
  .cursor-reveal {
    position: fixed;
    top: 0;
    left: 0;
    width: 30rem;
    height: 30rem;
    margin-top: -15rem;
    margin-left: -15rem;
    background: var(--color-hover-reveal);
    -webkit-mask-image: radial-gradient(circle, black 0%, black 45%, transparent 72%);
    mask-image: radial-gradient(circle, black 0%, black 45%, transparent 72%);
    filter: url(#cursor-reveal-edge);
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
    will-change: transform, opacity;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      background-color var(--duration-flip) var(--ease-out);
  }

  @media (pointer: coarse) {
    .cursor-reveal {
      display: none;
    }
  }
</style>

<script>
  function onIdle(callback: () => void) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback);
    } else {
      setTimeout(callback, 200);
    }
  }

  onIdle(async () => {
    const reveal = document.querySelector<HTMLElement>("[data-cursor-reveal]");
    if (!reveal || window.matchMedia("(pointer: coarse)").matches) return;

    const { withMotion } = await import("@/lib/motion");

    withMotion(({ gsap, reduced }) => {
      if (reduced) return;

      const moveX = gsap.quickTo(reveal, "x", { duration: 0.45, ease: "power3" });
      const moveY = gsap.quickTo(reveal, "y", { duration: 0.45, ease: "power3" });

      window.addEventListener("pointermove", (event) => {
        reveal.style.opacity = "1";
        moveX(event.clientX);
        moveY(event.clientY);
      });

      window.addEventListener("pointerleave", () => {
        reveal.style.opacity = "0";
      });
    });
  });
</script>
