---
// Cursor-following reveal. Now grounded in the actual reference video
// (extracted frames, since neither the SVG-turbulence nor the smooth-blob
// attempts before this matched it): the real effect is a halftone/stipple
// dot cluster with a gritty, speckled edge — not a smooth blob, not a
// wobbly noise blob. It's approximated here with a repeating dot pattern
// intersected with a soft radial falloff, so dots are dense in the center
// and thin out to scattered specks at the edge.
// It reveals the *other* theme's color at the pointer — red by default, as
// if the flipped theme were underneath; white once flipped, the reverse —
// and reverses again when the mark is clicked.
---

<div class="cursor-reveal" data-cursor-reveal aria-hidden="true"></div>

<style>
  .cursor-reveal {
    position: fixed;
    top: 0;
    left: 0;
    width: 22rem;
    height: 22rem;
    margin-top: -11rem;
    margin-left: -11rem;
    background: var(--color-hover-reveal);
    -webkit-mask-image:
      radial-gradient(circle at center, black 0%, black 45%, transparent 78%),
      repeating-radial-gradient(circle at center, black 0px, black 1.6px, transparent 1.6px, transparent 5.5px);
    mask-image:
      radial-gradient(circle at center, black 0%, black 45%, transparent 78%),
      repeating-radial-gradient(circle at center, black 0px, black 1.6px, transparent 1.6px, transparent 5.5px);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
    will-change: transform, opacity;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      background-color var(--duration-flip) var(--ease-out);
  }

  @media (pointer: coarse) {
    .cursor-reveal {
      display: none;
    }
  }
</style>

<script>
  function onIdle(callback: () => void) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback);
    } else {
      setTimeout(callback, 200);
    }
  }

  onIdle(async () => {
    const reveal = document.querySelector<HTMLElement>("[data-cursor-reveal]");
    if (!reveal || window.matchMedia("(pointer: coarse)").matches) return;

    const { withMotion } = await import("@/lib/motion");

    withMotion(({ gsap, reduced }) => {
      if (reduced) return;

      const moveX = gsap.quickTo(reveal, "x", { duration: 0.45, ease: "power3" });
      const moveY = gsap.quickTo(reveal, "y", { duration: 0.45, ease: "power3" });

      window.addEventListener("pointermove", (event) => {
        reveal.style.opacity = "1";
        moveX(event.clientX);
        moveY(event.clientY);
      });

      window.addEventListener("pointerleave", () => {
        reveal.style.opacity = "0";
      });
    });
  });
</script>
