---
// Cursor-following "watercolor stain" reveal. The SVG feTurbulence/
// feDisplacementMap approach tried earlier produced a jagged, torn-paper
// edge instead of a soft painterly one — pixel noise reads as static, not
// watercolor. This uses the classic organic-blob technique instead: an
// asymmetric border-radius (a closed, smoothly curved shape, not a mask)
// that slowly morphs between a few states, blurred for soft edges. No
// noise, so it can't look jagged — only smooth curves are possible.
// It reveals the *other* theme's color at the pointer — red by default, as
// if the flipped theme were underneath; white once flipped, the reverse —
// and reverses again when the mark is clicked.
---

<div class="cursor-reveal" data-cursor-reveal aria-hidden="true"></div>

<style>
  .cursor-reveal {
    position: fixed;
    top: 0;
    left: 0;
    width: 20rem;
    height: 20rem;
    margin-top: -10rem;
    margin-left: -10rem;
    background: radial-gradient(
      circle at 50% 50%,
      var(--color-hover-reveal) 0%,
      var(--color-hover-reveal) 55%,
      transparent 100%
    );
    border-radius: 42% 58% 65% 35% / 45% 45% 55% 55%;
    filter: blur(20px);
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
    will-change: transform, opacity;
    animation: cursor-blob-morph 9s ease-in-out infinite;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      background-color var(--duration-flip) var(--ease-out);
  }

  @keyframes cursor-blob-morph {
    0%,
    100% {
      border-radius: 42% 58% 65% 35% / 45% 45% 55% 55%;
    }
    33% {
      border-radius: 60% 40% 40% 60% / 55% 60% 40% 45%;
    }
    66% {
      border-radius: 48% 52% 58% 42% / 62% 44% 56% 38%;
    }
  }

  @media (pointer: coarse) {
    .cursor-reveal {
      display: none;
    }
  }
</style>

<script>
  function onIdle(callback: () => void) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback);
    } else {
      setTimeout(callback, 200);
    }
  }

  onIdle(async () => {
    const reveal = document.querySelector<HTMLElement>("[data-cursor-reveal]");
    if (!reveal || window.matchMedia("(pointer: coarse)").matches) return;

    const { withMotion } = await import("@/lib/motion");

    withMotion(({ gsap, reduced }) => {
      if (reduced) return;

      const moveX = gsap.quickTo(reveal, "x", { duration: 0.45, ease: "power3" });
      const moveY = gsap.quickTo(reveal, "y", { duration: 0.45, ease: "power3" });

      window.addEventListener("pointermove", (event) => {
        reveal.style.opacity = "1";
        moveX(event.clientX);
        moveY(event.clientY);
      });

      window.addEventListener("pointerleave", () => {
        reveal.style.opacity = "0";
      });
    });
  });
</script>
