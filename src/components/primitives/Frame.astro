---
// Recreation of the print registration-mark frame (legacy/images/Frame.svg) as
// independently-positioned marks instead of one stretched SVG. Each mark hugs its
// own corner/edge with a viewport-proportional margin (--frame-margin), so it stays
// correct at any aspect ratio instead of being letterboxed to the original 1684:963
// canvas.
//
// These are the corners/edge-midpoints of one implied rectangle, so each mark's
// horizontal and vertical strokes must meet at a single point (a real right angle) —
// not two disconnected segments.
//
// `fixed` (default true) pins the frame to the viewport, for pages that are
// exactly one viewport tall. Pages taller than that (the CV) pass
// `fixed={false}` so the frame instead spans its nearest positioned
// ancestor's *content* height — its bottom corners then sit at the true end
// of the page, only reached once you've scrolled there, rather than
// hovering over whatever happens to be on screen.
//
// `edgeTicks` (default true) toggles the two mid-edge ticks — pages with
// their own internal registration marks along the same edges (the CV grid)
// turn these off so the marks don't collide.
interface Props {
  fixed?: boolean;
  edgeTicks?: boolean;
}

const { fixed = true, edgeTicks = true } = Astro.props;
---

<div class:list={["frame", { "frame--absolute": !fixed }]} aria-hidden="true">
  <svg class="frame__corner frame__corner--tl" viewBox="0 0 28 28">
    <path d="M27 1 H1 V27" />
  </svg>
  <svg class="frame__corner frame__corner--tr" viewBox="0 0 28 28">
    <path d="M27 1 H1 V27" />
  </svg>
  <svg class="frame__corner frame__corner--br" viewBox="0 0 28 28">
    <path d="M27 1 H1 V27" />
  </svg>
  <svg class="frame__corner frame__corner--bl" viewBox="0 0 28 28">
    <path d="M27 1 H1 V27" />
  </svg>

  {
    edgeTicks && (
      <Fragment>
        <svg class="frame__tick frame__tick--left" viewBox="0 0 28 30">
          <path d="M1 1 V29 M1 15 H27" />
        </svg>
        <svg class="frame__tick frame__tick--right" viewBox="0 0 28 30">
          <path d="M1 1 V29 M1 15 H27" />
        </svg>
      </Fragment>
    )
  }
</div>

<style>
  .frame {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Sits above the CV's own grid content (z-index: 1) instead of below it —
     the point of the frame is to read as the outermost registration mark,
     so its corners must never be cut off by a divider or cell painting on
     top of them. Homepage content stays above the fixed frame (unchanged),
     since there the frame is just a background flourish in the margins. */
  .frame--absolute {
    position: absolute;
    z-index: 2;
  }

  .frame__corner,
  .frame__tick {
    position: absolute;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: miter;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }

  .frame__corner {
    width: 1.75rem;
    height: 1.75rem;
  }

  .frame__corner--tl {
    top: var(--frame-margin);
    left: var(--frame-margin);
  }

  .frame__corner--tr {
    top: var(--frame-margin);
    right: var(--frame-margin);
    transform: rotate(90deg);
  }

  .frame__corner--br {
    bottom: var(--frame-margin);
    right: var(--frame-margin);
    transform: rotate(180deg);
  }

  .frame__corner--bl {
    bottom: var(--frame-margin);
    left: var(--frame-margin);
    transform: rotate(270deg);
  }

  .frame__tick {
    width: 1.75rem;
    height: 1.875rem;
    top: 50%;
  }

  .frame__tick--left {
    left: var(--frame-margin);
    transform: translateY(-50%);
  }

  .frame__tick--right {
    right: var(--frame-margin);
    transform: translateY(-50%) scaleX(-1);
  }
</style>
