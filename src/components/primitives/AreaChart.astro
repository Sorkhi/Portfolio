---
// Server-rendered line/area chart (Soft Skills). Same build-time-geometry,
// zero-client-JS approach as RadarChart.astro.
interface Props {
  points: { label: string; value: number }[];
  class?: string;
}

const { points, class: className } = Astro.props;

const WIDTH = 640;
// Compact — this chart shares a grid row with Languages, so its height sets
// the row's height and was leaving Languages with a lot of unused space
// below its own (much shorter) content.
const HEIGHT = 140;
// Wide enough that the outermost labels' centered text never overflows the
// viewBox (an earlier, narrower pad let "Logical Thinking" spill past the
// right edge — with overflow:visible on the SVG, that meant spilling out of
// its cell too).
const PAD_X = 52;
const PAD_TOP = 14;
const PAD_BOTTOM = 24;
const plotHeight = HEIGHT - PAD_TOP - PAD_BOTTOM;
const plotWidth = WIDTH - PAD_X * 2;

const n = points.length;
const step = n > 1 ? plotWidth / (n - 1) : 0;

const coords = points.map((p, i) => ({
  x: PAD_X + step * i,
  y: PAD_TOP + plotHeight * (1 - p.value),
  ...p,
}));

const linePath = coords.map((c, i) => `${i === 0 ? "M" : "L"} ${c.x} ${c.y}`).join(" ");
const areaPath = `${linePath} L ${coords[coords.length - 1].x} ${PAD_TOP + plotHeight} L ${coords[0].x} ${PAD_TOP + plotHeight} Z`;

// Two evenly-spaced horizontal dividers split the plot into three bands.
const hGridY = [1 / 3, 2 / 3].map((f) => PAD_TOP + plotHeight * f);
---

<svg class:list={["area", className]} viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label="Soft skills chart">
  <desc>{points.map((p) => `${p.label}: ${Math.round(p.value * 100)}%`).join(", ")}</desc>

  <defs>
    <linearGradient id="area-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.32" />
      <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- faint grid: the plot's own box, two horizontal bands, and a vertical
       rule at every point — all thinner than the page's own box dividers,
       so this reads as a background grid rather than another registration
       line. -->
  <rect x={PAD_X} y={PAD_TOP} width={plotWidth} height={plotHeight} class="area__grid" />
  {hGridY.map((y) => <line x1={PAD_X} y1={y} x2={WIDTH - PAD_X} y2={y} class="area__grid" />)}
  {coords.map((c) => <line x1={c.x} y1={PAD_TOP} x2={c.x} y2={PAD_TOP + plotHeight} class="area__grid" />)}

  <path d={areaPath} fill="url(#area-fill)" />
  <path d={linePath} class="area__line" />

  {coords.map((c) => <rect x={c.x - 3} y={c.y - 3} width="6" height="6" class="area__vertex" />)}

  {
    coords.map((c) => (
      <text x={c.x} y={HEIGHT - 8} text-anchor="middle" class="area__label">
        {c.label}
      </text>
    ))
  }
</svg>

<style>
  .area {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .area__grid {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 0.75;
  }

  .area__line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .area__vertex {
    fill: var(--color-accent);
  }

  .area__label {
    fill: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 11px;
  }
</style>
